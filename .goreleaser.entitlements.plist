<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- PDFium runs as WebAssembly compiled to machine code at run time, so the
	     hardened runtime must let the process execute memory it wrote itself.
	     wazero maps that memory without MAP_JIT, so allow-jit is not enough. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
